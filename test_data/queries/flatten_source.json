{
  "roots": {
    "from-input": true
  },
  "walk": [
    "alias:to",
    "contained:down"
  ],
  "emit": {
    "expr": "{identifier: identifier, file_names: body.file_names}",
    "if": {
      "and": [
        {
          ">": {
            "depth": 0
          }
        },
        "length(connections.\"build:from\") > `0`"
      ]
    }
  }
}